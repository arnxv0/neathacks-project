[Unit]
Description=Preflight chaos proxy (:8300, loopback) between the target and Crustdata
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=preflight
Group=preflight
WorkingDirectory=/srv/preflight
Environment=HOME=/home/preflight
Environment=PATH=/home/preflight/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-/srv/preflight/.env
# Explicit --host keeps the coordinator's ensure_proxy() from starting a throwaway in-process proxy thread.
ExecStart=/home/preflight/.local/bin/uv run --no-sync preflight proxy --port 8300 --host 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
