# Copy to terraform.tfvars (gitignored) and fill in. No secrets here: those go to SSM (see ../README.md).
region              = "us-east-1"
instance_type       = "t4g.medium" # t4g.small (no fixers) | t4g.medium (2 fixers) | t4g.large (3 fixers)
admin_cidr          = "203.0.113.4/32" # `curl -s https://checkip.amazonaws.com`/32
ssh_public_key      = "ssh-ed25519 AAAA... you@mac"
judge_user          = "judge"
judge_password_hash = "$2a$14$REPLACE_WITH_OUTPUT_OF_caddy_hash-password"
git_ref             = "main"
fixers_max_parallel = 2
# repo_url          = "https://github.com/arnxv0/neathacks-project.git"
