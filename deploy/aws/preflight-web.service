[Unit]
Description=Preflight dashboard (Next.js production server, :3000, loopback)
After=network-online.target preflight-api.service
Wants=network-online.target

[Service]
Type=simple
User=preflight
Group=preflight
WorkingDirectory=/srv/preflight/apps/web
Environment=HOME=/home/preflight
Environment=PATH=/home/preflight/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
# NEXT_PUBLIC_API_URL is baked in at build time (bootstrap runs `npm run build` with it set to https://<host>).
ExecStart=/usr/bin/npm run start -- -p 3000 -H 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
