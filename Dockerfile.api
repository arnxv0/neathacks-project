FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim
WORKDIR /preflight
ENV UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv PYTHONUNBUFFERED=1 PREFLIGHT_LEDGER_DIR=/preflight/ledger
RUN apt-get update && apt-get install -y --no-install-recommends git make curl && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml uv.lock ./
COPY src ./src
RUN uv sync --frozen --no-dev
COPY . .
EXPOSE 8200 8300
CMD ["uv", "run", "--no-sync", "preflight", "web", "--host", "0.0.0.0", "--port", "8200"]
